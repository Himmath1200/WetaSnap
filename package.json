{
  "name": "weta-snap",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/api"
  ],
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:web": "npm run dev -w @wetasnap/web",
    "dev:api": "npm run dev -w @wetasnap/api",
    "dev:db": "npm run test:db -w @wetasnap/api",
    "build": "npm run build -w @wetasnap/web && npm run build -w @wetasnap/api",
    "test": "npm run test -w @wetasnap/web && npm run test -w @wetasnap/api",
    "typecheck": "npm run typecheck -w @wetasnap/web && npm run typecheck -w @wetasnap/api",
    "size": "npm run size -w @wetasnap/web",
    "migrate": "npm run migrate -w @wetasnap/api",
    "test:db": "npm run test:db -w @wetasnap/api",
    "seed": "npm run seed -w @wetasnap/api",
    "worker": "npm run worker -w @wetasnap/api",
    "mail": "npm run mail -w @wetasnap/api --"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "dexie": "^4.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.1",
    "nodemailer": "^7.0.12",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/web": "^0.0.364"
  }
}
