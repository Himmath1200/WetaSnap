{
  "name": "@wetasnap/api",
  "version": "1.0.0",
  "private": true,
  "description": "WeTa Snap API \u2014 NestJS + TypeScript on PostgreSQL, Redis-or-Postgres cache/queue and object storage.",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node --require ts-node/register/transpile-only src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "migrate": "node --require ts-node/register/transpile-only db/migrate.ts up",
    "migrate:status": "node --require ts-node/register/transpile-only db/migrate.ts status",
    "db:reset": "node --require ts-node/register/transpile-only db/migrate.ts reset",
    "seed": "node --require ts-node/register/transpile-only db/seed.ts",
    "test": "vitest run",
    "worker": "node --require ts-node/register/transpile-only src/worker.ts",
    "test:db": "node --require ts-node/register/transpile-only tools/test-db.ts",
    "smoke": "npm run db:reset && npm run seed && node test/integration/api.mjs && node test/integration/pipeline.mjs",
    "mail": "node tools/last-mail.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@types/express": "^5.0.6",
    "@types/node": "^24.9.2",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.6",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.1",
    "nodemailer": "^7.0.12",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "vitest": "^4.0.1"
  }
}
