# WeTa Snap API — copy to .env and fill in. Nothing here is read at build time.
NODE_ENV=development
PORT=4000

# --- PostgreSQL / Supabase Database -----------------------------------------
# Option A: Local PostgreSQL
# DATABASE_URL=postgres://wetasnap_app:CHANGE_ME@127.0.0.1:5433/wetasnap
# SERVICE_DATABASE_URL=postgres://wetasnap_service:CHANGE_ME@127.0.0.1:5433/wetasnap
# DATABASE_SSL=false

# Option B: Supabase (copy from Supabase Project Settings → Database → Connection string)
# Connection pooler URL (Transaction mode on port 6543):
DATABASE_URL=postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Direct connection URL (Session mode on port 5432):
SERVICE_DATABASE_URL=postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_SSL=true

# --- Redis (optional) ------------------------------------------------------
# Unset = cache, rate limiting and the job queue run on PostgreSQL + memory.
# REDIS_URL=redis://127.0.0.1:6379

# --- Object storage --------------------------------------------------------
# driver: fs (local folder) or s3 (any S3-compatible service, incl. MinIO)
STORAGE_DRIVER=fs
STORAGE_DIR=./storage
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# S3_REGION=eu-central-1
# S3_BUCKET=wetasnap
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Web app ---------------------------------------------------------------
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5180

# --- Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
# Signs session tokens and encrypts CRM credentials at rest.
SECRET_KEY=CHANGE_ME_32_BYTES
# Web push (optional): npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@wetano.com

# --- Email -----------------------------------------------------------------
# driver: log  — nothing is sent; each message is printed and kept in storage/mail, and listed at
#               http://localhost:4000/dev/mail (development only)
#         smtp — really sent through SMTP_URL
MAIL_DRIVER=log
MAIL_FROM="WeTa Snap <no-reply@wetano.com>"
# SMTP_URL=smtp://user:pass@smtp.example.com:587

# --- Demo convenience (development only) -----------------------------------
# The password every seeded account uses. While this is set, and MAIL_DRIVER=log, the sign-in page
# offers the accounts and shows the 6-digit code. Leave it empty in any real deployment.
DEV_DEMO_PASSWORD="WetaSnap#2026"   # quoted: an unquoted # starts a comment

# --- Card reading ----------------------------------------------------------
# The local OCR service (services/ocr). Leave blank to use on-device OCR only.
OCR_URL=http://127.0.0.1:8099
# Claude vision for the AI extraction step; without it the pipeline uses OCR + rules.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Embeddings for semantic contact search (pgvector). local = hashed n-grams, no network.
EMBEDDINGS_DRIVER=local
# VOYAGE_API_KEY=
