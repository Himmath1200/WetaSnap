# WeTa Snap local card reader — copy to .env and edit.
# Nothing here is required; every value below is the default.
# run.bat / run.sh read this file. Quote any value that contains spaces.

# Which reader to use: auto (Surya, then Tesseract), surya, or tesseract.
OCR_ENGINE=auto

# Where to listen. 0.0.0.0 is what lets a phone on the same Wi-Fi reach it.
# Use 127.0.0.1 to keep the service on this machine only.
OCR_HOST=0.0.0.0
OCR_PORT=8099

# Optional bearer token. Off while this is empty. When it is set, the app must
# send "Authorization: Bearer <token>" on POST /read. GET /health stays open so
# the app can still check whether the service is up.
# Worth setting on exhibition Wi-Fi, where the network is not yours.
OCR_TOKEN=

# Biggest request we will accept, in bytes (default 8 MB).
OCR_MAX_BODY_BYTES=8388608

# DEBUG, INFO, WARNING. Timings and counts are logged; card text never is.
OCR_LOG_LEVEL=INFO

# Windows only: where tesseract.exe lives. Leave empty if it is on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
