# Copy to .env.local. Leave VITE_API_URL empty to run in DEMO mode — a mock backend inside the
# browser, with nothing to install and nothing to start.
VITE_API_URL=

# Push notifications: the public half of the VAPID pair the API sends with (VAPID_* in services/api).
VITE_VAPID_PUBLIC_KEY=

# Local OCR service (services/ocr). Can also be set per device in Settings → Company.
VITE_OCR_URL=
