{
  "buildCommand": "npm run build",
  "installCommand": "npm install --include=dev",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/*.js": {
      "includeFiles": "services/api/dist/**",
      "maxDuration": 60,
      "memory": 1024
    },
    "api/**/*.js": {
      "includeFiles": "services/api/dist/**",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api/index?__v_path=/v1/:path*" },
    { "source": "/dev/:path*", "destination": "/api/index?__v_path=/dev/:path*" },
    { "source": "/health", "destination": "/api/index?__v_path=/health" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
